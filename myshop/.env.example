# Скопіюйте цей файл у .env і заповніть значення для локальної розробки.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
# У dev достатньо localhost. У prod додайте сюди реальний домен/IP сервера,
# інакше Django поверне 400 Bad Request на будь-який запит.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=myshop
POSTGRES_USER=myshop
POSTGRES_PASSWORD=myshop
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS ---
# У dev дозволено все (config/settings/dev.py). У prod nginx віддає й
# фронтенд, і /api/ з одного origin, тож CORS здебільшого не задіяний —
# але залиште порожнім або вкажіть свій домен, якщо ходите на API з
# іншого хоста.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- TLS / безпека (лише для prod за реальним доменом із HTTPS) ---
# За замовчуванням ВИМКНЕНО, бо naш docker-compose.prod.yml + nginx
# обслуговують звичайний HTTP без сертифіката (див. коментар у
# config/settings/prod.py). Якщо додасте домен + TLS (certbot тощо) —
# розкоментуйте й переведіть у True:
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=2592000

# --- Email (у prod буде реальний SMTP) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@myshop.local
ADMIN_EMAIL=admin@myshop.local
