# Скопіюйте цей файл у .env і заповніть значення для локальної розробки.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=myshop
POSTGRES_USER=myshop
POSTGRES_PASSWORD=myshop
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS (тільки для prod; у dev дозволено все) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email (у prod буде реальний SMTP) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@myshop.local
